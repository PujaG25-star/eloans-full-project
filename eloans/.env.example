# Google AdSense — the dashboard right-rail ad unit.
# Copy this file to `.env` and fill both values in. Until they are set the
# slot renders a labelled placeholder instead of calling AdSense.
#
# Both come from your AdSense dashboard once the site is approved:
#   CLIENT — Account > Settings > Account information ("publisher ID")
#   SLOT   — Ads > By ad unit > (create a Display unit) > slot ID
#
# These are compiled into the client bundle and are public by design;
# AdSense IDs are not secrets. Do not put anything private in a VITE_ var.

VITE_ADSENSE_CLIENT=ca-pub-0000000000000000
VITE_ADSENSE_SLOT=0000000000
